# Copy to app/keystore.properties (git-ignored) and fill in. NEVER commit real values.
# Alternatively export RAHEL_KEYSTORE_FILE, RAHEL_KEYSTORE_PASSWORD, RAHEL_KEY_ALIAS, RAHEL_KEY_PASSWORD.
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
